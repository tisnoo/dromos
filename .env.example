# Only needed for the first login; afterwards the token store is used.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where Garmin tokens are stored (default: ~/.dromos/garmin-tokens)
GARMINTOKENS=
# SQLite database file (default: ~/.dromos/dromos.db)
DROMOS_DB=
# Public URL of the app (server only; OAuth metadata and redirects are built from it)
DROMOS_BASE_URL=
# Password you type on the login page when connecting Claude (long and random)
DROMOS_OWNER_PASSWORD=
# Static bearer token for Hermes (generate with: openssl rand -hex 32)
DROMOS_API_TOKEN=
# Dashboard: Google sign-in, only this address gets in. OAuth client from Google Cloud
# Console (Web application), redirect URI <DROMOS_BASE_URL>/dashboard/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROMOS_DASHBOARD_EMAIL=
# Signs the dashboard session cookie (generate with: openssl rand -hex 32)
DROMOS_SESSION_SECRET=
# Hermes agent: Dromos POSTs new runs and a daily brief to its webhook platform (see README).
# Base URL of Hermes' webhooks, e.g. http://127.0.0.1:8644/webhooks, and the shared secret
# set on the dromos-run / dromos-daily routes (generate with: openssl rand -hex 32)
DROMOS_HERMES_WEBHOOK_URL=
DROMOS_HERMES_WEBHOOK_SECRET=
# Your timezone: the daily brief goes at 06:00 here (default: UTC)
DROMOS_TIMEZONE=
