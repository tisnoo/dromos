# Only needed for the first login; afterwards the token store is used.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where Garmin tokens are stored (default: ~/.dromos/garmin-tokens)
GARMINTOKENS=
# SQLite database file (default: ~/.dromos/dromos.db)
DROMOS_DB=
# Public URL of the app (server only; OAuth metadata and redirects are built from it)
DROMOS_BASE_URL=
# Password you type on the login page when connecting Claude (long and random)
DROMOS_OWNER_PASSWORD=
# Static bearer token for Hermes (generate with: openssl rand -hex 32)
DROMOS_API_TOKEN=
